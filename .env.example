# RecoSphere stack config (docker compose). `make up` copies this to .env on first run; edit .env, never
# commit it. Every value here is read by infra/compose/docker-compose.yml; the defaults are the same.
# Running the web app outside docker (`cd web; npm run dev`) uses web/.env.local instead (web/.env.example).

# ---------------------------------------------------------------------------- secrets (change these)
# signs the web session cookie: a long random string
AUTH_SECRET=change-me-local-dev-only-0123456789
# app_api <-> web shared secret (X-Service-Token): a long random string
SERVICE_TOKEN=change-me-to-a-long-random-string
# app database (Neon): the -pooler url for app_api, the direct url for Alembic / scripts
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=verify-full
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
# empty = engine /admin/* open; if set, the web app sends it to the engine automatically
ADMIN_TOKEN=

# ---------------------------------------------------------------------------- web app (RecoSphere Play)
# admins: users with role 'admin' in Postgres (python -m app_api.cli create-admin --email <email>)
# 1 behind https; 0 for plain http on localhost/LAN (a secure cookie is dropped over http)
COOKIE_SECURE=0

# ---------------------------------------------------------------------------- engine (serve/)
RANKFORGE_CATEGORY=Video_Games
# new-item slots in the top-10 (notebook 06 decision)
NEW_ITEM_SLOTS=2
# threads per request (1 = stable p95)
SERVE_THREADS=1
# uvicorn workers; one Python process ~ one core (GIL). Workers share user state through Redis.
API_WORKERS=4
# poll models/<cat>/production.json this often and hot-swap on change; 0 = off
MODEL_WATCH_SECONDS=10

# ---------------------------------------------------------------------------- host ports
WEB_PORT=3000
API_PORT=8000
APP_API_PORT=8100
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ---------------------------------------------------------------------------- model registry (P2)
# S3 server for trained runs + the production pointer (docs/platform/P2_ROADMAP.md). Local: SeaweedFS
# (`make s3-up`). Any S3 works (AWS, MinIO): change the url and keys. Empty S3_ENDPOINT_URL = local-disk mode.
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_ACCESS_KEY_ID=recosphere
S3_SECRET_ACCESS_KEY=change-me-to-a-long-random-string
S3_BUCKET=recosphere
# AWS S3 instead (IAM user with a bucket-only policy, NO permissions boundary that lacks s3:*; never root keys):
#   S3_ENDPOINT_URL=https://s3.<region>.amazonaws.com  S3_REGION=<region>  S3_ADDRESSING_STYLE=virtual
#   S3_BUCKET=<your bucket>  S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY from the IAM user's access key
S3_ADDRESSING_STYLE=path
# where the production pointer lives: local (models/<cat>/production.json, default) or s3 (needs S3_* above)
MODEL_REGISTRY=local
# s3 mode, engine side: verified copies of runs + gold snapshots land here; MODEL_NAMESPACE serves a namespaced
# pointer (demos), never needed in normal use
MODEL_CACHE_DIR=.local/registry-cache
MODEL_NAMESPACE=
