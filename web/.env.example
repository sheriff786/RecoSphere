# Copy to .env.local and adjust.
# RecoSphere engine (uvicorn serve.app:app)
ENGINE_URL=http://127.0.0.1:8000
# long random string; signs the session cookie
AUTH_SECRET=change-me-to-a-long-random-string
# SQLite file for app accounts + play sessions (until the app moves to Postgres, P1)
DATABASE_PATH=./data/app.db
# Postgres (DB_SCHEMA.md). Neon: the -pooler host for the app, the direct host for migrations (make db-migrate).
# Never commit real values; CI uses its own Postgres container.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=verify-full
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
# comma separated; these accounts can open /admin
ADMIN_EMAILS=admin@recosphere.dev
# seeds admin@recosphere.dev on first start (local demo only)
ADMIN_PASSWORD=admin12345
# = ADMIN_TOKEN of the engine, if you set one
ENGINE_ADMIN_TOKEN=
