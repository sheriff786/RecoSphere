# Copy to .env.local and adjust.
# RecoSphere engine (uvicorn serve.app:app)
ENGINE_URL=http://127.0.0.1:8000
# app_api: accounts, sessions, library, plays (Postgres). APP_API_TOKEN = SERVICE_TOKEN in app_api/.env
APP_API_URL=http://127.0.0.1:8100
APP_API_TOKEN=change-me-to-the-same-long-random-string
# long random string; signs the session cookie (a JWT carrying the app_api session id)
AUTH_SECRET=change-me-to-a-long-random-string
# 1 behind https; 0 for plain http on localhost/LAN
COOKIE_SECURE=0
# = ADMIN_TOKEN of the engine, if you set one
ENGINE_ADMIN_TOKEN=
# Admins are users with role 'admin' in Postgres: ADMIN_PASSWORD=... python -m app_api.cli create-admin --email <email>
# Legacy Node migration runner only (web/db/migrate.mjs, frozen; removed in P1 phase H):
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=verify-full
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
