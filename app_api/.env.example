# Copy to app_api/.env (git-ignored) and fill in. Never commit real values.
# Neon: the -pooler host for the app (DATABASE_URL), the direct host for Alembic (DATABASE_URL_DIRECT).
# sslmode=verify-full: the server certificate is verified (app_api passes certifi's CA bundle).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=verify-full&channel_binding=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full&channel_binding=require
