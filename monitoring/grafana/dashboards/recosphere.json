{
  "uid": "recosphere",
  "title": "RecoSphere serving",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "recosphere"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Model served (1 = live)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (model_run) (recosphere_model_info) == 1",
          "legendFormat": "{{model_run}}"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Requests / s",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(recosphere_requests_total[1m]))",
          "legendFormat": "rps"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(recosphere_request_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Error share",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(recosphere_errors_total{kind=\"recommend\"}[5m])) or vector(0)) / clamp_min(sum(rate(recosphere_requests_total[5m])),1e-9)",
          "legendFormat": "errors"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Requests / s by arm and source",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (arm, source) (rate(recosphere_requests_total[1m]))",
          "legendFormat": "{{arm}} / {{source}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Latency by arm (p50 / p95 / p99)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, arm) (rate(recosphere_request_seconds_bucket[5m])))",
          "legendFormat": "{{arm}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, arm) (rate(recosphere_request_seconds_bucket[5m])))",
          "legendFormat": "{{arm}} p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, arm) (rate(recosphere_request_seconds_bucket[5m])))",
          "legendFormat": "{{arm}} p99"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "p95 per stage",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(recosphere_stage_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Fallback share (users without history)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(recosphere_requests_total{source=\"fallback\"}[5m])) or vector(0)) / clamp_min(sum(rate(recosphere_requests_total[5m])),1e-9)",
          "legendFormat": "fallback"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Median #1 score by model (drift)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, model_run) (rate(recosphere_top_score_bucket[10m])))",
          "legendFormat": "{{model_run}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Mean new-item share in served lists",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (arm) (rate(recosphere_new_item_share_sum[10m])) / clamp_min(sum by (arm) (rate(recosphere_new_item_share_count[10m])),1e-9)",
          "legendFormat": "{{arm}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "A/B live monitor: clicks per request by arm (decide offline with ab/analyze.py!)",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (arm) (rate(recosphere_feedback_total{action=\"click\"}[15m])) / clamp_min(sum by (arm) (rate(recosphere_requests_total[15m])),1e-9)",
          "legendFormat": "{{arm}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Model reloads",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(recosphere_model_reloads_total[1h]))",
          "legendFormat": "{{result}}"
        }
      ],
      "id": 12
    }
  ]
}